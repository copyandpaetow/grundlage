{
	"name": "grundlage-repo",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.11"
	},
	"scripts": {
		"dev": "npm run dev -w website",
		"build": "npm run build -w grundlage",
		"build:plugin": "npm run build -w vite-plugin-grundlage",
		"build:site": "npm run build -w website",
		"preview": "npm run preview -w website",
		"test": "vitest",
		"test:unit": "vitest --project unit",
		"test:dom": "vitest --project unit --project dom --project browser-as-dom --project prerender-plugin",
		"test:cubes": "vitest  --project cubes",
		"test:browser": "vitest --project browser",
		"test:ci": "npm run typecheck -w grundlage && vitest run",
		"test:coverage": "vitest run --coverage",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"version:patch": "npm version patch -w grundlage",
		"version:minor": "npm version minor -w grundlage",
		"version:major": "npm version major -w grundlage",
		"version:plugin:patch": "npm version patch -w vite-plugin-grundlage",
		"version:plugin:minor": "npm version minor -w vite-plugin-grundlage",
		"version:plugin:major": "npm version major -w vite-plugin-grundlage",
		"release": "npm run test:ci && npm publish -w grundlage",
		"release:plugin": "npm run build -w vite-plugin-grundlage && npm test -- --run && npm publish -w vite-plugin-grundlage"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"@vitest/browser-playwright": "^5.0.2",
		"@vitest/coverage-v8": "^5.0.2",
		"happy-dom": "^20.3.7",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2",
		"vite": "^8.0.1",
		"vitest": "^5.0.2"
	},
	"overrides": {
		"happy-dom": "$happy-dom"
	},
	"workspaces": [
		"lib",
		"website",
		"prerender-plugin"
	],
	"allowScripts": {
		"fsevents": false
	}
}
