{
	"name": "grundlage-repo",
	"private": true,
	"scripts": {
		"dev": "npm run dev -w website",
		"build": "npm run build -w grundlage",
		"build:site": "npm run build -w website",
		"preview": "npm run preview -w website",
		"test": "vitest",
		"test:unit": "vitest --project unit",
		"test:dom": "vitest --project unit --project dom --project browser-as-dom --project prerender-plugin",
		"test:cubes": "vitest  --project cubes",
		"test:browser": "vitest --project browser",
		"test:ci": "vitest run",
		"test:coverage": "vitest run --coverage",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"version:patch": "npm version patch -w grundlage",
		"version:minor": "npm version minor -w grundlage",
		"version:major": "npm version major -w grundlage",
		"release": "npm run build -w grundlage && npm test -- --run && npm publish -w grundlage"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-v8": "^4.1.2",
		"happy-dom": "^20.3.7",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2",
		"vite": "^8.0.1",
		"vitest": "^4.1.0"
	},
	"overrides": {
		"happy-dom": "$happy-dom"
	},
	"workspaces": [
		"lib",
		"website",
		"prerender-plugin"
	],
	"allowScripts": {
		"fsevents": false
	}
}
