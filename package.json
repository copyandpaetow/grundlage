{
	"name": "grundlage-repo",
	"private": true,
	"scripts": {
		"dev": "npm run dev -w website",
		"build": "npm run build -w grundlage",
		"build:site": "npm run build -w website",
		"preview": "npm run preview -w website",
		"test": "vitest",
		"test:unit": "vitest --project unit",
		"test:dom": "vitest --project unit --project dom --project browser-as-dom --project prerender-plugin",
		"test:cubes": "vitest  --project cubes",
		"test:browser": "vitest --project browser",
		"test:ci": "vitest run",
		"test:bench": "node scripts/bench.mjs vitest bench --config vitest.bench.config.ts",
		"bench:baseline": "node scripts/bench.mjs vitest bench --run --config vitest.bench.config.ts --outputJson=bench/baseline.json",
		"bench:compare": "node scripts/bench.mjs vitest bench --run --config vitest.bench.config.ts --compare=bench/baseline.json",
		"bench:gate": "node scripts/bench.mjs vitest bench --run --config vitest.bench.config.ts --outputJson=bench/current.json && node scripts/bench-compare.mjs bench/baseline.json bench/current.json",
		"test:coverage": "vitest run --coverage",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"version:patch": "npm version patch -w grundlage",
		"version:minor": "npm version minor -w grundlage",
		"version:major": "npm version major -w grundlage",
		"release": "npm run build -w grundlage && npm test -- --run && npm publish -w grundlage"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"@vitest/browser-playwright": "^4.1.0",
		"@vitest/coverage-v8": "^4.1.2",
		"prettier": "3.8.3",
		"vitest": "^4.1.0"
	},
	"workspaces": [
		"lib",
		"website",
		"prerender-plugin"
	]
}
