{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"strictPropertyInitialization": false
	},
	"include": [
		"index.ts",
		"ssr-render.ts",
		"index.test.ts",
		"tsdown.config.ts",
		"__fixtures__/**/*.ts"
	]
}
